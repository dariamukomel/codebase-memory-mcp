# tree-sitter-cli fetches its native binary via its own postinstall script
# (install.js), not npm's optionalDependencies mechanism. A global
# ignore-scripts=true — a reasonable default elsewhere — silently skips that
# script here, leaving the wrapper package installed with no binary to run.
# This repo's own install-time scripts (this one included) are required and
# trusted; opt back in for just this project rather than disabling the
# global protection.
ignore-scripts=false
