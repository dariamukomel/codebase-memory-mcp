## Docs (VitePress); everything under docs/ is generated except
## docs/index.md, docs/changelog.md, and docs/.vitepress/*.mjs (config).
## dist/ above already covers docs/.vitepress/dist/.
/docs/.vitepress/cache/
/docs/coverage.md
/docs/downloads.md
/docs/public/artifacts/

## ANTLR corroborator toolchain (tools/coverage.py); fetched/built by
## tools/antlr/setup.sh, never committed.
/tools/antlr/grammars-v4/
/tools/antlr/*.jar
/tools/antlr/build/

# Generated GLR scan report (regenerate via tools/perf/glr_scan.py)
tools/perf/glr_report.json
tools/perf/glr_report.md

# Generated parse-throughput report (regenerate via tools/perf/parse_bench.py).
# tools/perf/parse_bench.json is NOT ignored; it is the committed baseline --check
# compares against, same arrangement as tools/coverage.json.
tools/perf/parse_bench.md

# Generated by scripts/bundle-highlights.js (rebuilt by inflate-parsers.js)
/*/queries/highlights.bundled.scm

# Statement inventory (tools/inventory.py): the reference-parser cache and the
# generated report. tools/inventory-results/*.json is the committed baseline.
tools/inventory-results/.cache/
/docs/inventory.md
# Real-world SQL fetched by tools/corpus/corpus_audit.py
tools/corpus/cache/

# Inventory work queue: agent scratch, tools venv
.venv-tools/
